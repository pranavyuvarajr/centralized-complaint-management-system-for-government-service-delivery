# Copy this file to .env (or set these as real environment variables / cloud secrets).
# The app also works with zero configuration for local dev - see application.properties defaults.

# --- Database (Neon, Railway, Supabase, or local Postgres all work) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/complaint_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# --- Server ---
PORT=8080

# --- Security ---
# Must be a long random string in any real deployment.
JWT_SECRET=ChangeThisToALongRandomSecretBeforeDeployingAnywherePublic
JWT_EXPIRATION_MS=86400000

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ORIGINS=http://localhost:5173

# Location search (all optional - these are the defaults)
# GEOCODER_PROVIDER=photon              # photon (default) or nominatim: which is asked first; the other is the fallback
# GEOCODER_PHOTON_URL=https://photon.komoot.io
# GEOCODER_NOMINATIM_URL=https://nominatim.openstreetmap.org
# GEOCODER_COUNTRY_CODES=in             # preferred countries, comma-separated ISO codes; empty = worldwide

# --- File uploads ---
UPLOAD_DIR=uploads

# --- Urgent complaints: alert emails & reminders ---
# Public URL of the frontend; used for the links inside emails (urgent alerts, alert-email verification).
FRONTEND_BASE_URL=http://localhost:5173
# MAIL_ENABLED=false (default) = log-only mode: emails and their links are written to the backend log, nothing is sent.
MAIL_ENABLED=true
# Brevo SMTP (set MAIL_ENABLED=true to use it). MAIL_FROM must be a sender verified in Brevo.
# Some hosting providers block outbound SMTP; if mail never arrives, check that and the backend log.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=pranavyuvarajr@gmail.com
MAIL_PASSWORD=bzzwlawnljmqtpti
MAIL_FROM=pranavyuvarajr@gmail.com
# Reminder schedule (ISO-8601 durations). Defaults: reminders every 6h (x4), admin escalation 5 minutes after the 4th.
# For quick testing: URGENCY_REMINDER_INTERVAL=PT1M and URGENCY_ESCALATION_DELAY=PT20S
# URGENCY_REMINDER_INTERVAL=PT6H
# URGENCY_ESCALATION_DELAY=PT5M
# URGENCY_SCHEDULER_ENABLED=true

